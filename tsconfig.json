{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-dev/dev/types/**/*.ts",
    ".next-dev-aliases-20261031/types/**/*.ts",
    ".next-dev-aliases-20261031/dev/types/**/*.ts",
    ".next-dev-restaurants-20261031/types/**/*.ts",
    ".next-dev-restaurants-20261031/dev/types/**/*.ts",
    ".next-prod-copy-20261118_222107/types/**/*.ts",
    ".next-prod-copy-20261118_222107/dev/types/**/*.ts",
    ".next-security-verify-20261118/types/**/*.ts",
    ".next-security-verify-20261118/dev/types/**/*.ts",
    ".next-security-verify-20261118b/types/**/*.ts",
    ".next-security-verify-20261118b/dev/types/**/*.ts",
    ".next-prod-copy-next1646-20261118/types/**/*.ts",
    ".next-prod-copy-next1646-20261118/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
