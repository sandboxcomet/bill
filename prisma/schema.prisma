generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "mysql"
 url = env("DATABASE_URL")
}

model User {
 id Int @id @default(autoincrement())
 name String?
 nickname String? @db.VarChar(40)
 username String? @unique @db.VarChar(24)
 email String? @unique
 emailVerified DateTime? @map("email_verified")
 image String? @db.Text
 promptPayId String? @map("prompt_pay_id")
 authVersion Int @default(0) @map("auth_version")
 passkeyUserHandle String? @unique @map("passkey_user_handle") @db.VarChar(64)
 passkeys Passkey[]
 mergedIntoId Int? @map("merged_into_id")
 mergedInto User? @relation("MergedAccounts", fields: [mergedIntoId], references: [id], onDelete: Restrict)
 mergedAccounts User[] @relation("MergedAccounts")
 accounts Account[]
 sessions Session[]
 bills Bill[]
 billParticipations Participant[] @relation("AccountParticipant")
 friendshipsLow Friendship[] @relation("FriendLow")
 friendshipsHigh Friendship[] @relation("FriendHigh")
 friendRequests Friendship[] @relation("FriendRequester")
 friendGroups FriendGroup[]
  personalAliases PersonalAlias[] @relation("AliasOwner")
  aliasesForMe PersonalAlias[] @relation("AliasTarget")
 groupMemberships FriendGroupMember[]
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 @@index([mergedIntoId])
 @@map("users")
}

model PersonalAlias {
  ownerId Int @map("owner_id")
  targetId Int @map("target_id")
  name String? @db.VarChar(191)
  owner User @relation("AliasOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  target User @relation("AliasTarget", fields: [targetId], references: [id], onDelete: Restrict)

  @@id([ownerId, targetId])
  @@map("personal_aliases")
}

model Passkey {
 id String @id @default(cuid())
 userId Int @map("user_id")
 user User @relation(fields: [userId], references: [id], onDelete: Restrict)
 credentialId String @map("credential_id") @db.Text
 credentialHash String @unique @map("credential_hash") @db.Char(64)
 publicKey Bytes @map("public_key") @db.Blob
 userHandle String @map("user_handle") @db.VarChar(64)
 counter BigInt @default(0)
 transports Json
 deviceType String @map("device_type") @db.VarChar(32)
 backedUp Boolean @map("backed_up")
 name String @db.VarChar(80)
 createdAt DateTime @default(now()) @map("created_at")
 lastUsedAt DateTime? @map("last_used_at")
 revokedAt DateTime? @map("revoked_at")
 @@index([userId, revokedAt])
 @@map("passkeys")
}

model PasskeyChallenge {
 id String @id @db.Char(64)
 purpose String @db.VarChar(16)
 challenge String @db.VarChar(128)
 userId Int? @map("user_id")
 authVersion Int? @map("auth_version")
 expiresAt DateTime @map("expires_at")
 consumedAt DateTime? @map("consumed_at")
 createdAt DateTime @default(now()) @map("created_at")
 @@index([expiresAt])
 @@map("passkey_challenges")
}

model AccountConnection {
 id String @id @db.Char(64)
 initiatorId Int @map("initiator_id")
 initiatorVersion Int @map("initiator_version")
 provider String @db.VarChar(16)
 providerAccountId String? @map("provider_account_id")
 targetUserId Int? @map("target_user_id")
 targetVersion Int? @map("target_version")
 profileName String? @map("profile_name")
 status String @default("STARTED") @db.VarChar(16)
 primaryUserId Int? @map("primary_user_id")
 expiresAt DateTime @map("expires_at")
 createdAt DateTime @default(now()) @map("created_at")
 completedAt DateTime? @map("completed_at")
 @@index([initiatorId, status])
 @@map("account_connections")
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int     @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique @map("session_token")
  userId       Int      @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Bill {
  version Int @default(0)
  id     String @id @default(cuid())
  userId Int    @map("user_id")
  owner  User   @relation(fields: [userId], references: [id], onDelete: Cascade)


  name            String  @map("name")
  restaurants     Json?
  receiptSubtotal Decimal @map("receipt_subtotal") @db.Decimal(18, 2)
  totalDiscount   Decimal @default(0) @map("total_discount") @db.Decimal(18, 2)
  serviceCharge   Decimal @default(0) @map("service_charge") @db.Decimal(18, 2)
  serviceChargeType String? @default("฿") @map("service_charge_type")
  serviceChargeValue Decimal? @default(0) @map("service_charge_value") @db.Decimal(18, 2)
  vat             Decimal @default(0) @db.Decimal(18, 2)
  vatType         String? @default("฿") @map("vat_type")
  vatValue        Decimal? @default(0) @map("vat_value") @db.Decimal(18, 2)
  vatIncludesSc   Boolean? @default(false) @map("vat_includes_sc")
  grandTotal      Decimal @map("grand_total") @db.Decimal(18, 2)

  isPublic Boolean @default(true) @map("is_public")
  passcode String? // plain PIN (4 digits)
  status   String  @default("DRAFT") // DRAFT | PUBLISHED | UNSHARED | CANCELLED
  itemPayersEnabled Boolean @default(false) @map("item_payers_enabled")

  items        BillItem[]
  participants Participant[]
  settlements BillSettlement[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("bills")
}

model BillItem {
  id     String @id @default(cuid())
  billId String @map("bill_id")
  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)

  name         String
  restaurantId String? @map("restaurant_id")
  price        Decimal @db.Decimal(18, 2)
  quantity     Int     @default(1)
  discountRate Decimal @default(0) @map("discount_rate") @db.Decimal(18, 2)
  isShared     Boolean @default(false) @map("is_shared")
  includeSc    Boolean @default(true) @map("include_sc")
  includeVat   Boolean @default(true) @map("include_vat")
  consumerQuantities Json? @map("consumer_quantities") // participant ID to proportional quantity

  consumers Participant[]
  payerId String? @map("payer_id")
  payer Participant? @relation("ItemPayer", fields: [payerId], references: [id], onDelete: Restrict)

  @@map("bill_items")
}

model Participant {
  archived Boolean @default(false)
  id     String @id @default(cuid())
  billId String @map("bill_id")
  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)

  name         String
  ownerAlias   String? @map("owner_alias")
  accountUserId Int? @map("account_user_id")
  accountUser User? @relation("AccountParticipant", fields: [accountUserId], references: [id], onDelete: Restrict)
  totalPayable Decimal  @default(0) @map("total_payable") @db.Decimal(18, 2)
  paidAmount   Decimal  @default(0) @map("paid_amount") @db.Decimal(18, 2) // Track verified cumulative payment
  isPaid       Boolean  @default(false) @map("is_paid")
  isPayer      Boolean  @default(false) @map("is_payer")
  promptPayId String? @map("prompt_pay_id") @db.VarChar(13)
  shareAmount Decimal @default(0) @map("share_amount") @db.Decimal(18, 2)
  paidUpfront Decimal @default(0) @map("paid_upfront") @db.Decimal(18, 2)

  consumedItems BillItem[]
  paidItems BillItem[] @relation("ItemPayer")
  outgoing BillSettlement[] @relation("SettlementFrom")
  incoming BillSettlement[] @relation("SettlementTo")

  @@map("participants")
}

model BillSettlement {
  id String @id @default(cuid())
  billId String @map("bill_id")
  bill Bill @relation(fields: [billId], references: [id], onDelete: Restrict)
  fromParticipantId String @map("from_participant_id")
  toParticipantId String @map("to_participant_id")
  fromParticipant Participant @relation("SettlementFrom", fields: [fromParticipantId], references: [id], onDelete: Restrict)
  toParticipant Participant @relation("SettlementTo", fields: [toParticipantId], references: [id], onDelete: Restrict)
  amount Decimal @db.Decimal(18, 2)
  paidAmount Decimal @default(0) @map("paid_amount") @db.Decimal(18, 2)
  isPaid Boolean @default(false) @map("is_paid")
  archived Boolean @default(false)

  @@unique([billId, fromParticipantId, toParticipantId], map: "settlement_pair")
  @@index([fromParticipantId])
  @@index([toParticipantId])
  @@map("bill_settlements")
}

model PaymentEvidence {
  payloadHash String? @unique @map("payload_hash") @db.Char(64)
  encryptedSlip String? @map("encrypted_slip") @db.Text
  providerJobId String? @unique @map("provider_job_id") @db.VarChar(64)
  queuedAt DateTime? @map("queued_at")
  nextCheckAt DateTime? @map("next_check_at")
  leaseUntil DateTime? @map("lease_until")
  retryCount Int @default(0) @map("retry_count")
  transactedAt DateTime? @map("transacted_at")
  reviewReason String? @map("review_reason")
  targetVersion Int @default(0) @map("target_version")
  id String @id @default(cuid())
  provider String @default("easyslip")
  reference String
  targetType String @map("target_type")
  targetId String @map("target_id")
  amount Decimal @db.Decimal(18, 2)
  status String @default("NEEDS_REVIEW")
  objectKey String? @map("object_key")
  submittedBy Int? @map("submitted_by")
  confirmedBy Int? @map("confirmed_by")
  receiverMatch Boolean @default(false) @map("receiver_match")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@unique([provider, reference])
  @@index([targetType, targetId])
  @@index([status, nextCheckAt])
  @@map("payment_evidence")
}

model PaymentAudit {
  id String @id @default(cuid())
  targetType String @map("target_type")
  targetId String @map("target_id")
  actorId Int @map("actor_id")
  action String
  reason String @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  @@index([targetType, targetId])
  @@map("payment_audit")
}

model RequestQuota {
  key String @id
  count Int @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  @@index([expiresAt])
  @@map("request_quotas")
}

model Friendship {
  id String @id @default(cuid())
  lowUserId Int @map("low_user_id")
  highUserId Int @map("high_user_id")
  requesterId Int @map("requester_id")
  status String @default("PENDING")
  source String @default("REQUEST")
  lowUser User @relation("FriendLow", fields: [lowUserId], references: [id], onDelete: Restrict)
  highUser User @relation("FriendHigh", fields: [highUserId], references: [id], onDelete: Restrict)
  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@unique([lowUserId, highUserId], map: "friendship_pair")
  @@index([highUserId, status])
  @@map("friendships")
}

model FriendGroup {
  id String @id @default(cuid())
  userId Int @map("user_id")
  name String @db.VarChar(80)
  owner User @relation(fields: [userId], references: [id], onDelete: Restrict)
  members FriendGroupMember[]
  createdAt DateTime @default(now()) @map("created_at")
  @@index([userId])
  @@map("friend_groups")
}

model FriendGroupMember {
  id String @id @default(cuid())
  groupId String @map("group_id")
  userId Int @map("user_id")
  group FriendGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([groupId, userId], map: "friend_group_member")
  @@index([userId])
  @@map("friend_group_members")
}
