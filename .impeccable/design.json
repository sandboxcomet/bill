  "narrative": {
    "northStar": "The Shared-Meal Ledger",
    "overview": "Light paper surfaces, deep green actions and a continuous receipt make item assignment and payment amounts easy to scan at a shared table. The visual identity is practical and calm: participants stay next to the items they consume, while totals receive stronger size and contrast than supporting explanations.\n\nThis records the implemented recommendation in the standalone bill project. The direction is open to further user feedback; no user-provided visual reference or approved generated comp establishes formal visual approval. The durable language is Thai-first, with Latin and numeric text handled by Manrope. Page strategy and the first-viewport contract remain in `docs/surface-brief.md`.",
    "keyCharacteristics": [
      "White ledger panels on a light gray-green canvas.",
      "Deep green actions, selected states and prominent totals.",
      "Compact item rows, attached participant controls and right-aligned amounts.",
      "Restrained participant colors and consistent stroke SVG icons.",
      "Flat working surfaces with dashed receipt separators."
    ],
    "rules": [
      {
        "name": "The Action Green Rule",
        "body": "Use the green family for actionable or financial emphasis; keep ordinary reading surfaces neutral.",
        "section": "colors"
      },
      {
        "name": "The Decimal Alignment Rule",
        "body": "Use tabular numerals for financial values and right-align values in comparison rows. Keep currency and amount together where space permits.",
        "section": "typography"
      },
      {
        "name": "The Attached Assignment Rule",
        "body": "Preserve each item's fields and consumer selection as one visual group when stacking or wrapping the layout.",
        "section": "layout"
      },
      {
        "name": "The Flat Ledger Rule",
        "body": "Use borders and tonal surfaces for working containers. Reserve lifted paper depth for the illustrative receipt.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep amounts tabular and right-aligned in ledger rows.",
      "**Do** keep participant selection visually attached to its item when layouts stack.",
      "**Do** use Thai-first labels and the established mixed-script font stack.",
      "**Do** preserve visible keyboard focus and reduced-motion behavior.",
      "**Do** label illustrative receipt data as example data."
    ],
    "donts": [
      "**Don't** spread the illustrative receipt's rotation and shadow onto working panels.",
      "**Don't** use color alone to communicate payment or validation state.",
      "**Don't** replace authored stroke SVG icons with text glyphs.",
      "**Don't** add game, XP or celebratory visual treatments to this bill-only interface."
    ]
  }
