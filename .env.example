# Separate database. Never point this app at the main WongLao database.
DATABASE_URL=mysql://bill:change-me@127.0.0.1:3306/wonglao_bill
AUTH_SECRET=
AUTH_URL=http://localhost:3002
PORT=3002
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_LINE_ID=
AUTH_LINE_SECRET=
PAYMENT_LINK_SECRET=
# SLIP_PENDING only: production async queue + durable polling fallback.
# Set the same signing secret in the EasySlip branch to enable webhook wakeups.
EASYSLIP_WEBHOOK_SECRET=
# Optional public HTTPS callback; defaults to AUTH_URL/api/webhooks/easyslip.
# Local HTTP development uses scheduled sync retries instead.
EASY_SLIP_CALLBACK_URL=
EASY_SLIP_KEY=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
PAYMENT_R2_BUCKET_NAME=

# Container deployment only: use URL-safe passwords matching its database user.
BILL_DB_PASSWORD=change-me
BILL_DB_ROOT_PASSWORD=change-root-password
BILL_IMAGE=sandboxcomet/wonglao-bill
