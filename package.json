{
  "name": "wonglao-bill",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "rm -rf .next && next dev --turbopack --port 3000",
    "build": "prisma generate && next build && node scripts/prepare-standalone.mjs",
    "start": "HOSTNAME=0.0.0.0 node --env-file-if-exists=.env .next/standalone/server.js",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.30",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "@auth/prisma-adapter": "2.11.1",
    "@prisma/client": "6.19.3",
    "@aws-sdk/client-s3": "3.1022.0",
    "decimal.js": "10.6.0",
    "promptpay-qr": "0.5.0",
    "qrcode.react": "4.2.0",
    "sharp": "0.34.5",
    "jsqr": "1.4.0",
    "qrcode": "0.9.0"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.0.0"
  }
}
